# @tldr-dump:
#     Dump the data recorder to a file
#
# Since: 11.2.0
#
# .. qmp-example::
#
#     -> { "execute": "tldr-dump", "arguments": { "target": "/tmp/qemu.txt" } }
#     <- { "return": {} }
